{
  "name": "cedar-embeddable-term-picker",
  "description": "CEDAR Embeddable Term Picker (CETP), a reusable Web Component for choosing what constrains a CEDAR field.",
  "version": "0.1.0-dev.20260917.55cb50c3",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:ci": "npm run lint && npm run typecheck && npm test && npm run test:packaging && npm run build:production && npm run test:browser:prebuilt && npm run bundle && npm run check:size && npm run package:npm",
    "test:browser": "npm run build:production && npm --prefix browser test",
    "test:browser:prebuilt": "npm --prefix browser test",
    "types:public": "tsc -p tsconfig.public-api.json",
    "bundle": "node scripts/make-bundle.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "package:npm": "npm run types:public && node scripts/stage-npm-package.mjs && npm run check:npm-package",
    "check:npm-package": "node scripts/check-npm-package.mjs",
    "test:packaging": "node --test scripts/npm-package.test.mjs",
    "dist": "npm run build:production && npm run bundle && npm run check:size && npm run package:npm"
  },
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/elements": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20260918.219b1a29",
    "@types/node": "^24.9.2",
    "angular-eslint": "^22.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-embeddable-term-picker.git"
  },
  "bugs": {
    "url": "https://github.com/metadatacenter/cedar-embeddable-term-picker/issues"
  },
  "homepage": "https://github.com/metadatacenter/cedar-embeddable-term-picker#readme",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
